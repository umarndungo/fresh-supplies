ENVIRONMENT=development
# Must match DB_USER / DB_PASS / DB_NAME in the root .env (docker compose + db/bootstrap.sh
# provision that role). If you customize those, update this URL to match — a literal @ in the
# password is URL-encoded as %40.
DATABASE_URL=postgresql+asyncpg://freshrouteadmin:freshroute%402120@localhost:5432/freshroute
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
FRONTEND_ORIGIN=http://localhost:3000
REFRESH_COOKIE_NAME=frs_refresh_token
COOKIE_SECURE=true

# Mobile app login OTP is emailed via SMTP. SMTP_PASSWORD must be a Gmail
# *App Password* (Google Account -> Security -> 2-Step Verification -> App
# passwords) — Gmail rejects your normal account password for SMTP AUTH.
# Leave SMTP_ENABLED=false (the default) to just log OTP codes instead of
# emailing them, e.g. for local dev with no real mailbox to send from.
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=amosndungo@gmail.com
SMTP_PASSWORD=
SMTP_FROM_EMAIL=amosndungo@gmail.com
SMTP_FROM_NAME=Fresh Supplies
