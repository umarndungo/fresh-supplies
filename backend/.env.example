ENVIRONMENT=development
# Must match DB_USER / DB_PASS / DB_NAME in the root .env (docker compose + db/bootstrap.sh
# provision that role). If you customize those, update this URL to match — a literal @ in the
# password is URL-encoded as %40.
DATABASE_URL=postgresql+asyncpg://freshrouteadmin:freshroute%402120@localhost:5432/freshroute
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
FRONTEND_ORIGIN=http://localhost:3000
REFRESH_COOKIE_NAME=frs_refresh_token
COOKIE_SECURE=false
